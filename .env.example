# FinAlly configuration. Copy to .env (the start scripts do this for you).
# Never commit .env.

# Required for real AI chat (OpenRouter; model runs on Cerebras)
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) key for real market data; empty = built-in simulator
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (tests / dev without a key)
LLM_MOCK=false

# --- Optional advanced settings (defaults shown in comments) ---
# Seed the simulator for reproducible prices (unset = random)
# SIMULATOR_SEED=42
# Seconds between Massive REST polls (default 5; free tier needs >= 15)
# MASSIVE_POLL_INTERVAL=15
# SQLite path (local default: <repo>/db/finally.db; Docker sets /app/db/finally.db)
# FINALLY_DB_PATH=
# Static frontend dir (local default: <repo>/frontend/out; Docker sets /app/static)
# FINALLY_STATIC_DIR=
